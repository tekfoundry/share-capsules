{
    "manifest_version": 3,
    "name": "Share Capsules",
    "version": "0.1.0",
    "description": "Creates and views Share Capsules without exposing protected content to websites.",
    "permissions": [
        "identity",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://sharecapsules.com/*",
        "https://broker.sharecapsules.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*"
    ],
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://sharecapsules.com/studio/capsules/create"
            ],
            "js": [
                "creator-handoff.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "viewer-frame.html",
                "viewer-frame.css",
                "viewer-frame.js"
            ],
            "matches": [
                "https://*/*"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
    },
    "key": ""
}
